# FocusPilot Configuration Example
# Copy to .env and modify as needed

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8765
BACKEND_LOG_LEVEL=INFO

# Frontend Configuration
FRONTEND_PORT=5173
TAURI_WINDOW_WIDTH=900
TAURI_WINDOW_HEIGHT=700

# ActivityWatch Configuration
ACTIVITYWATCH_HOST=localhost
ACTIVITYWATCH_PORT=5600
ACTIVITYWATCH_ENABLED=true

# Monitoring Configuration
MONITOR_INTERVAL_SECONDS=2
DISTRACTION_THRESHOLD_MINUTES=2
DISTRACTION_PROBABILITY_THRESHOLD=0.7

# Database Configuration
DATABASE_PATH=backend/focuspilot.db
DATABASE_BACKUP_ENABLED=true

# ML Model Configuration
MODEL_PATH=backend/model.pkl
PREDICTOR_PATH=backend/predictor.pkl
USE_ML_MODELS=true
FALLBACK_TO_RULES=true

# Notification Configuration
NOTIFY_URL=http://localhost:3000/notify
NOTIFICATION_TIMEOUT_SECONDS=5

# Development Configuration
DEBUG_MODE=false
LOG_TO_FILE=true
LOG_FILE=backend/backend.log
